{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary reliability estimate",
  "type": "object",
  "required": [
    "schema_version",
    "k",
    "tasks",
    "trials",
    "pass_at_1",
    "pass_power_k",
    "confidence_interval",
    "security_violations"
  ],
  "properties": {
    "schema_version": {
      "const": "skillcanary/reliability/v1"
    },
    "k": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "integer",
      "minimum": 0
    },
    "trials": {
      "type": "integer",
      "minimum": 0
    },
    "pass_at_1": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "pass_power_k": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_interval": {
      "type": "object"
    },
    "cost_per_success": {
      "type": [
        "number",
        "null"
      ]
    },
    "p95_latency_ms": {
      "type": "number"
    },
    "security_violations": {
      "type": "integer",
      "minimum": 0
    }
  }
}
