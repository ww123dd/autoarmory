{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary experience capsule",
  "type": "object",
  "required": ["id", "skill", "problem", "context", "method", "evidence", "verification", "applicability", "provenance", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "problem": { "type": "string", "minLength": 1 },
    "context": { "type": "string", "minLength": 1 },
    "method": { "type": "string", "minLength": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "verification": {
      "type": "object",
      "required": ["verified_by", "oracle", "result"],
      "properties": {
        "verified_by": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "unknown"] },
        "evidence": { "type": "string" }
      }
    },
    "applicability": { "type": "string", "minLength": 1 },
    "provenance": {
      "type": "object",
      "required": ["source_sessions"],
      "properties": {
        "source_sessions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "generated_by": { "type": "string" },
        "derived_from": { "type": "array", "items": { "type": "string" } },
        "supersedes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": { "enum": ["advice", "candidate", "case", "shadow", "warning", "blocking", "quarantined", "retired"] },
    "canary": { "type": "string" },
    "created_at": { "type": "string" },
    "expires_at": { "type": "string" }
  }
}