{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary armor piece",
  "type": "object",
  "required": ["id", "skill", "scope", "trigger", "rule", "status", "evidence", "created_at"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "trigger": { "enum": ["session_start", "before_tool", "after_task", "ci", "manual"] },
    "rule": { "type": "string", "minLength": 1 },
    "status": { "enum": ["advice", "candidate", "case", "shadow", "warning", "blocking", "quarantined", "retired"] },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "canary": { "type": "string" },
    "fallback": { "type": "string" },
    "expires_at": { "type": "string" },
    "created_at": { "type": "string" }
  }
}