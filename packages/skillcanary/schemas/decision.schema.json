{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary decision record",
  "type": "object",
  "required": ["schema_version", "id", "state", "action", "prediction", "outcome", "verification"],
  "properties": {
    "schema_version": { "const": "skillcanary/decision/v1" },
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "state": {
      "type": "object",
      "required": ["skill", "task_context", "failure_mode"],
      "properties": {
        "skill": { "type": "string", "minLength": 1 },
        "skill_hash": { "type": "string" },
        "task_context": { "type": "string", "minLength": 1 },
        "failure_mode": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "budget": { "type": "string" }
      }
    },
    "action": {
      "type": "object",
      "required": ["type", "target", "summary"],
      "properties": {
        "type": { "enum": ["add_rule", "remove_rule", "split_file", "change_route", "add_case", "add_hook", "change_tool_contract", "rollback"] },
        "target": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 }
      }
    },
    "prediction": {
      "type": "object",
      "required": ["expected_fix", "regression_risk"],
      "properties": {
        "expected_fix": { "type": "array", "items": { "type": "string" } },
        "regression_risk": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outcome": {
      "type": "object",
      "required": ["fixed", "regressed"],
      "properties": {
        "fixed": { "type": "array", "items": { "type": "string" } },
        "regressed": { "type": "array", "items": { "type": "string" } },
        "cost_delta": { "type": "number" },
        "user_correction_delta": { "type": "number" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["verified_by", "oracle", "result"],
      "properties": {
        "verified_by": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "unknown"] }
      }
    },
    "reward": { "type": "number" }
  }
}