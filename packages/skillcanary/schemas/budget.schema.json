{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary error budget",
  "type": "object",
  "required": [
    "window",
    "max"
  ],
  "properties": {
    "window": {
      "type": "integer",
      "minimum": 1
    },
    "max": {
      "type": "object",
      "required": [
        "user_correction_count",
        "rework_turns",
        "tool_error_count"
      ],
      "properties": {
        "user_correction_count": {
          "type": "integer",
          "minimum": 0
        },
        "rework_turns": {
          "type": "integer",
          "minimum": 0
        },
        "tool_error_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
