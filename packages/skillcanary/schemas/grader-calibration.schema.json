{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary grader calibration",
  "type": "object",
  "required": [
    "schema_version",
    "quality",
    "observed",
    "expected",
    "total"
  ],
  "properties": {
    "schema_version": {
      "const": "skillcanary/grader-calibration/v1"
    },
    "quality": {
      "enum": [
        "trusted",
        "cautious",
        "unusable"
      ]
    },
    "kappa": {
      "type": [
        "number",
        "null"
      ]
    },
    "observed": {
      "type": "number"
    },
    "expected": {
      "type": "number"
    },
    "total": {
      "type": "integer"
    }
  }
}
