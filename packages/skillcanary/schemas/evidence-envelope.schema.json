{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary evidence envelope",
  "type": "object",
  "required": ["schema_version", "run_id", "skill", "kind", "observed_at"],
  "properties": {
    "schema_version": { "const": "skillcanary/evidence/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "minLength": 1 },
    "skill_hash": { "type": "string" },
    "engine": { "type": "string" },
    "model": { "type": "string" },
    "case_id": { "type": "string" },
    "kind": { "enum": ["case", "deterministic"] },
    "before": { "$ref": "#/definitions/observation" },
    "after": { "$ref": "#/definitions/observation" },
    "check": { "type": "string" },
    "count_before": { "type": "integer", "minimum": 0 },
    "count_after": { "type": "integer", "minimum": 0 },
    "evidence": { "type": "string" },
    "verification": {
      "type": "object",
      "required": ["verified_by", "oracle", "result"],
      "properties": {
        "verified_by": { "type": "string", "minLength": 1 },
        "oracle": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "unknown"] }
      }
    },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "observed_at": { "type": "string" }
  },
  "definitions": {
    "observation": {
      "type": "object",
      "required": ["pass", "total"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}