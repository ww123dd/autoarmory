{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary cases",
  "type": "object",
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "skillcanary/cases/v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "criteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["stable", "observation", "unstable"] },
          "criteria": { "type": "string", "minLength": 1 },
          "held_out": { "type": "boolean" },
          "source": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}