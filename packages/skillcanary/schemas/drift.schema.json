{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary drift result",
  "type": "object",
  "required": [
    "skill",
    "samples",
    "detected",
    "score",
    "threshold"
  ],
  "properties": {
    "skill": {
      "type": "string"
    },
    "skill_hash": {
      "type": "string"
    },
    "samples": {
      "type": "integer"
    },
    "detected": {
      "type": "boolean"
    },
    "score": {
      "type": "number"
    },
    "threshold": {
      "type": "number"
    },
    "index": {
      "type": "integer"
    },
    "baseline": {
      "type": "number"
    },
    "risk": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  }
}
