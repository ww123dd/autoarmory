{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary trace envelope",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "skill",
    "spans",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skillcanary/trace/v1"
    },
    "run_id": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "engine": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "duration_ms": {
            "type": "number"
          },
          "tool": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "object",
              "null"
            ]
          }
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  }
}
