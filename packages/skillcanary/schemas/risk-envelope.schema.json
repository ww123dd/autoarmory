{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillCanary risk envelope",
  "type": "object",
  "required": [
    "schema_version",
    "skill",
    "scanner",
    "findings",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skillcanary/risk/v1"
    },
    "skill": {
      "type": "string",
      "minLength": 1
    },
    "scanner": {
      "type": "string",
      "minLength": 1
    },
    "risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "risk_severity": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "rule",
          "message"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    "observed_at": {
      "type": "string"
    }
  }
}
