{
  "schema_version": "autoarmory/verifiers-lock/v1",
  "note": "Portable profile: deterministic, machine-independent, offline. Run it with `node scripts/profile-run.js --profile examples/profiles/portable.profile.json`; the run must show at least one PASS and one FAIL. One entry is anchored outside this repository: examples/anchors/ms-2.1.3.tgz is vendored byte for byte from the npm registry publication of ms@2.1.3, and the published sha512 is recorded and re-checked in tests/portable-profile.js. The remaining entries are content-addressed inside this repository, so they detect drift but are not independent of the author; the repository-history entry reads git objects instead of the working tree.",
  "verifiers": [
    {
      "id": "portable-upstream-ms-tarball",
