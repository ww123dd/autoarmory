{
  "schema_version": "autoarmory/verifiers-lock/v1",
  "note": "Portable profile: deterministic, machine-independent, offline. Run it with `node scripts/profile-run.js --profile examples/profiles/portable.profile.json`; the run must show at least one PASS and one FAIL. Entries target only surfaces that are stable across checkouts: files pinned to eol=lf in .gitattributes, and this repository own history (server.repo = \".\", resolved read-only against the clone that runs the profile). Every entry is content-addressed inside this repository, so the run detects drift and proves the checker can fail; an entry is only independent of the author when its expectation is anchored outside the repository (an upstream published artifact hash, a vendored file upstream provenance hash, or a third-party read-only service body).",
  "verifiers": [
    {
      "id": "portable-bridge-self-sha256",
      "kind": "file-sha256",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
      "readonly": true,
      "adapter": "scripts/verify/state-query.js",
      "adapter_sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097",
      "statement": "The committed file-sha256 bridge must still hash to its pinned digest.",
      "assertion": {
        "path": "match",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/file-sha256/bridge.js",
        "adapter_sha256": "7df40f974faa61c971bc66be7cd893bc503d2eb4bf398305642469ede6e520c6",
        "server": {
          "name": "portable-file",
          "path": "examples/adapters/file-sha256/bridge.js",
          "sha256": "7df40f974faa61c971bc66be7cd893bc503d2eb4bf398305642469ede6e520c6"
        }
      }
    },
    {
      "id": "portable-verifier-core-sha256",
      "kind": "file-sha256",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
      "readonly": true,
      "adapter": "scripts/verify/state-query.js",
      "adapter_sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097",
      "statement": "The committed verifier core adapter must still hash to its pinned digest.",
      "assertion": {
        "path": "match",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/file-sha256/bridge.js",
        "adapter_sha256": "7df40f974faa61c971bc66be7cd893bc503d2eb4bf398305642469ede6e520c6",
        "server": {
          "name": "portable-file",
          "path": "scripts/verify/state-query.js",
          "sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097"
        }
      }
    },
    {
      "id": "portable-repo-commit-exists",
      "kind": "git-commit-exists",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
      "readonly": true,
      "adapter": "scripts/verify/state-query.js",
      "adapter_sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097",
      "statement": "The commit this profile was written against must exist in the history of the clone that runs it.",
      "assertion": {
        "path": "exists",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/git-commit-exists/bridge.js",
        "adapter_sha256": "836c570b08083519e82a6a230ae689d3ce21a2cebfd76abc6fcce361d57feefc",
        "server": {
          "name": "portable-git",
          "repo": ".",
          "commit": "06cdbccbaa1faa0d7752a846272e21db36c3f366"
        }
      }
    },
    {
      "id": "portable-negative-control-sha256",
      "kind": "file-sha256",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
      "readonly": true,
      "adapter": "scripts/verify/state-query.js",
      "adapter_sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097",
      "statement": "Negative control: the file-sha256 bridge must NOT hash to an all-zero digest. This entry is expected to FAIL; a checker that reports PASS here is dead.",
      "assertion": {
        "path": "match",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/file-sha256/bridge.js",
        "adapter_sha256": "7df40f974faa61c971bc66be7cd893bc503d2eb4bf398305642469ede6e520c6",
        "server": {
          "name": "portable-file",
          "path": "examples/adapters/file-sha256/bridge.js",
          "sha256": "0000000000000000000000000000000000000000"
        }
      }
    },
    {
      "id": "portable-negative-commit-missing",
      "kind": "git-commit-exists",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
