      "statement": "Negative control: an all-zero commit must NOT exist in this repository. This entry is expected to FAIL; a checker that reports PASS here is dead.",
      "assertion": {
        "path": "exists",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/git-commit-exists/bridge.js",
        "adapter_sha256": "836c570b08083519e82a6a230ae689d3ce21a2cebfd76abc6fcce361d57feefc",
        "server": {
          "name": "portable-git",
          "repo": ".",
          "commit": "0000000000000000000000000000000000000000"
        }
      }
    }
  ]
