{
  "schema_version": "autoarmory/verifiers-lock/v1",
  "note": "Portable profile: deterministic, machine-independent, offline. Run it with `node scripts/profile-run.js --profile examples/profiles/portable.profile.json`; the run must show at least one PASS and one FAIL. Three entries are anchored outside this repository, in examples/anchors/, from three different channels (npm registry, PyPI, the git source repository named by the npm publication): the vendored bytes and the published digests are recorded in <file>.provenance.json and re-checked by tests/portable-profile.js. The remaining entries are content-addressed inside this repository, so they detect drift but are not independent of the author; the repository-history entry reads git objects instead of the working tree.",
  "verifiers": [
    {
      "id": "portable-upstream-ms-tarball",
      "kind": "file-sha256",
      "version": "1.0.0",
      "invocation_contract_version": "autoarmory/invocation-contract/v1",
      "readonly": true,
      "adapter": "scripts/verify/state-query.js",
      "adapter_sha256": "f085eb4d4f0fc934d98801af389ed0777442352b55a5cad4f9845ab298176097",
      "statement": "The vendored npm artifact ms@2.1.3 must still hash to the registry published bytes (examples/anchors/ms-2.1.3.tgz.provenance.json).",
      "assertion": {
        "path": "match",
        "op": "eq",
        "value": true
      },
      "timeout_ms": 10000,
      "bridge": {
        "adapter": "examples/adapters/file-sha256/bridge.js",
        "adapter_sha256": "7df40f974faa61c971bc66be7cd893bc503d2eb4bf398305642469ede6e520c6",
        "server": {
          "name": "portable-file",
          "path": "examples/anchors/ms-2.1.3.tgz",
          "sha256": "f6616e15e530ed552f9daa2d3ce71963947c6bc7c98c9b64fd3e673fd02622c6"
        }
      }
    },
    {
