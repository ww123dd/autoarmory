    "src",
    "schemas",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "packages",
    "!docs/superpowers",
    "!docs/learning",
    "!docs/reading",
    "!packages/skillcanary/docs/reading",
    "scripts/verify",
    "examples/adapters",
    "examples/anchors",
    "examples/profiles"
  ],
  "scripts": {
    "test": "node tests/context-budget.js && node tests/trigger-contract.js && node tests/trigger-regression-evidence.js && node tests/replay-policy.js && node tests/replay-evidence.js && node tests/boundary-policy.js && node tests/audit-trace.js && node tests/json-assert.js && node tests/user-surface.js && node tests/sampling.js && node tests/run.js && node tests/approval-loop.js && node tests/capability.js && node tests/failure-modes.js && node tests/demo.js && node tests/bench.js && node tests/integrate.js && node tests/admission.js && node tests/scenario.js && node tests/api.js && node tests/aliases.js && node packages/skillcanary/tests/run.js && node tests/change-gate.js && node scripts/pack-check.js && node tests/observe-precision.js && node tests/persistence.js && node tests/mechanism.js && node scripts/evolution-metrics.js && node tests/inc-real-02-checker.js && node tests/verification.js && node tests/stale-verdict.js && node tests/verifier-pin.js && node tests/portable-profile.js && node tests/verifier-bridges.js && node tests/operator-loop.js && node tests/rollback.js && node tests/shadow.js && node tests/http-bytes.js && node tests/capability-evidence-health.js && node tests/candidate-rollback.js && node tests/inventory.js && node scripts/check-attestations.js && node tests/anchor-and-exec.js && node tests/selection-baseline.js && node tests/lifecycle-sweep.js && node tests/mechanism-preflight.js && node scripts/acceptance-check.js",
    "observe:example": "node bin/autoarmory.js observe examples/incidents.jsonl --output .selfforge/incidents.jsonl",
    "propose:example": "node bin/autoarmory.js propose examples/incidents.jsonl --output .selfforge/candidates.jsonl",
    "learn:example": "node bin/autoarmory.js learn examples/decisions.jsonl",
    "evolve:example": "node bin/autoarmory.js evolve examples/incidents.jsonl --cases examples/skillcanary-cases.json --json",
    "test:conformance": "node tests/conformance.js",
    "test:canary": "node packages/skillcanary/tests/run.js",
    "test:articles": "node tests/failure-modes.js",
    "test:trigger-contract": "node tests/trigger-contract.js",
    "test:trigger-regression-evidence": "node tests/trigger-regression-evidence.js",
    "test:replay-policy": "node tests/replay-policy.js",
    "test:replay-evidence": "node tests/replay-evidence.js",
    "test:boundary-policy": "node tests/boundary-policy.js",
    "test:self-eval": "node tests/self-eval.js",
    "check:anchors": "node scripts/anchor-refresh.js --fetch",
    "test:operator-loop": "node tests/operator-loop.js",
    "test:rollback": "node tests/rollback.js",
    "test:shadow": "node tests/shadow.js",
    "test:http-bytes": "node tests/http-bytes.js",
    "test:capability-health": "node tests/capability-evidence-health.js",
    "test:candidate-rollback": "node tests/candidate-rollback.js",
    "test:inventory": "node tests/inventory.js",
    "check:attestations": "node scripts/check-attestations.js",
    "test:anchor-and-exec": "node tests/anchor-and-exec.js",
    "test:selection-baseline": "node tests/selection-baseline.js",
    "test:lifecycle-sweep": "node tests/lifecycle-sweep.js",
    "check:acceptance": "node scripts/acceptance-check.js",
    "demo": "node bin/autoarmory.js demo --seed 7 --output demo.md --json",
    "bench": "node bin/autoarmory.js bench --seed 11 --output capability-routing-bench.md --json",
    "test:change-gate": "node tests/change-gate.js",
    "hooks:install": "node scripts/install-hooks.js",
    "test:pack": "node scripts/pack-check.js",
    "test:observe-precision": "node tests/observe-precision.js",
    "test:persistence": "node tests/persistence.js",
    "test:mechanism": "node tests/mechanism.js",
    "test:metrics": "node scripts/evolution-metrics.js",
    "test:inc-real-02": "node tests/inc-real-02-checker.js",
    "test:verification": "node tests/verification.js",
    "test:negative-controls": "node scripts/negative-controls.js",
    "test:verifier-scorecard": "node scripts/verifier-scorecard.js",
    "test:verifier-bridges": "node tests/verifier-bridges.js",
    "test:stale-verdict": "node tests/stale-verdict.js",
    "test:verifier-pin": "node tests/verifier-pin.js",
    "test:portable-profile": "node tests/portable-profile.js",
    "test:verifier-preflight": "node scripts/verifier-preflight.js",
    "test:mechanism-preflight": "node tests/mechanism-preflight.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "capability-management",
