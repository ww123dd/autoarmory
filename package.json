{
  "name": "autoarmory",
  "version": "2.9.0",
  "description": "A local capability manager for one operator, built on SkillCanary evidence and gates.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "autoarmory": "bin/autoarmory.js",
    "selfforge": "bin/selfforge.js",
    "self-forge": "bin/selfforge.js"
  },
  "files": [
