{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory routing decision",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "selected",
    "rejected",
    "fallback_chain",
    "reason",
    "policy_version",
    "seed",
    "evidence_refs",
    "task_id",
    "candidate_set",
    "top_k",
    "selection_margin",
    "selection_confidence",
    "confidence_method"
  ],
  "properties": {
    "schema_version": {
      "const": "autoarmory/routing-decision/v1"
    },
    "request_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "candidate_set": {
      "type": "array"
    },
    "top_k": {
      "type": "array"
    },
    "selection_margin": {
      "type": ["number", "null"]
    },
    "selection_confidence": {
      "type": ["number", "null"]
    },
    "confidence_method": {
      "type": "string"
    },
    "selected": {
      "type": "array"
    },
    "rejected": {
      "type": "array"
    },
    "fallback_chain": {
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "seed": {
      "type": "number"
    },
    "evidence_refs": {
      "type": "array"
    }
  }
}
