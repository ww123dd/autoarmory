{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory case",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "usage_contract_id",
    "title",
    "expected",
    "actual",
    "evidence",
    "reproducible",
    "failure_mode",
    "severity"
  ],
  "properties": {
    "schema_version": {
      "const": "autoarmory/case/v1"
    },
    "id": {
      "type": "string"
    },
    "usage_contract_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "actual": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "reproducible": {
      "const": true
    },
    "failure_mode": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
