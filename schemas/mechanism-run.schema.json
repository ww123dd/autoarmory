{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory Mechanism Run",
  "type": "object",
  "required": ["schema_version", "id", "mechanism_id", "case_id", "actor", "evidence_refs", "result", "input_sha256", "output_sha256", "exit_code", "counterexample", "environment_fingerprint", "verification_result", "started_at", "finished_at"],
  "properties": {
    "schema_version": { "const": "autoarmory/mechanism-run/v1" },
    "id": { "type": "string", "minLength": 1 },
    "mechanism_id": { "type": "string", "minLength": 1 },
    "case_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "verifier", "input_sha256", "output_sha256", "exit_code"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verifier": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "params": { "type": "object" },
          "input_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "output_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "exit_code": { "type": "integer" }
        },
        "additionalProperties": true
      }
    },
    "result": { "enum": ["pass", "fail"] },
    "input_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "output_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "exit_code": { "type": "integer" },
    "counterexample": { "type": "object", "minProperties": 1 },
    "environment_fingerprint": { "type": "string", "minLength": 1 },
    "regression": { "type": "boolean" },
    "verification_result": {
      "type": "object",
      "required": ["schema_version", "status", "reason", "repo", "checks", "refs"],
      "properties": {
        "schema_version": { "const": "autoarmory/verification/v1" },
        "status": { "enum": ["verified", "mismatch", "unverifiable"] },
        "reason": { "type": "string" },
        "repo": { "type": "string" },
        "checks": { "type": "array" },
        "refs": { "type": "array" },
        "input_sha256": { "type": ["string", "null"] },
        "output_sha256": { "type": ["string", "null"] },
        "exit_code": { "type": ["integer", "null"] },
        "result": { "enum": ["pass", "fail", null] }
      },
      "additionalProperties": true
    },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
