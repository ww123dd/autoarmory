{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory mechanism run",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "mechanism_id",
    "case_id",
    "actor",
    "verified_by",
    "verified",
    "result",
    "evidence",
    "regression",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": {
      "const": "autoarmory/mechanism-run/v1"
    },
    "id": {
      "type": "string"
    },
    "mechanism_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "partial"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "regression": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    }
  }
}
