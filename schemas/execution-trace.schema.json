{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory Execution Trace",
  "type": "object",
  "required": ["schema_version", "id", "decision_id", "task_id", "skill_id", "steps_expected", "steps_observed", "order_ok", "stop_conditions_ok", "environment_fingerprint", "isolation", "artifact_refs", "started_at", "finished_at"],
  "anyOf": [{ "required": ["plan"] }, { "required": ["plan_sha256"] }],
  "properties": {
    "schema_version": { "const": "autoarmory/execution-trace/v1" },
    "id": { "type": "string", "minLength": 1 },
    "decision_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "skill_id": { "type": "string", "minLength": 1 },
    "plan": { "type": "object" },
    "plan_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "status": { "enum": ["conformant", "nonconformant"] },
    "steps_expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "steps_observed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "expected_step_id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expected_step_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["completed", "skipped", "failed", "out_of_order"] },
          "evidence_ref": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "order_ok": { "type": "boolean" },
    "stop_conditions_ok": { "type": "boolean" },
    "environment_fingerprint": { "type": "string", "minLength": 1 },
    "isolation": {
      "type": "object",
      "required": ["independent_process", "temp_workspace", "namespace", "dependency_versions", "evidence_refs"],
      "properties": {
        "independent_process": { "type": "boolean" },
        "temp_workspace": { "type": "boolean" },
        "namespace": { "type": ["string", "null"] },
        "dependency_versions": { "type": "object" },
        "evidence_refs": { "type": "array" }
      },
      "additionalProperties": true
    },
    "artifact_refs": { "type": "array" },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}