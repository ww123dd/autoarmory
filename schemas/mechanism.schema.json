{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory Mechanism",
  "type": "object",
  "required": ["schema_version", "id", "name", "covered_failure_modes", "trigger", "action", "verification", "verifier_id", "closure_criteria", "owner", "version"],
  "properties": {
    "schema_version": { "const": "autoarmory/mechanism/v1" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "covered_failure_modes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "trigger": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "verification": { "type": "string", "minLength": 1 },
    "verifier_id": { "type": "string", "minLength": 1 },
    "closure_criteria": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "verification_stale_days": { "type": "integer", "minimum": 1 },
    "scope": { "type": "object" },
    "scope_sha256": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
    "expires_at": { "type": ["string", "null"] },
    "reopen_trigger": { "type": "array", "items": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["runner_changed", "case_changed", "scope_changed", "file_changed", "evidence_expired", "environment_changed"] }, "target": { "type": "string" }, "expected_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } }, "additionalProperties": true } }
  },
  "additionalProperties": true
}
