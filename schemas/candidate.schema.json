{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory candidate",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "incident_id",
    "action",
    "target",
    "expected_transition",
    "prediction",
    "evidence",
    "risk",
    "status",
    "change"
  ],
  "properties": {
    "schema_version": {
      "const": "selfforge/candidate/v1"
    },
    "id": {
      "type": "string"
    },
    "incident_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "action_tier": {
      "enum": [
        "read_only",
        "local_write",
        "irreversible_write",
        "external_side_effect"
      ]
    },
    "target": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "case",
            "deterministic"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "expected_transition": {
      "enum": [
        "FAIL->PASS",
        "COUNT->0"
      ]
    },
    "prediction": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "pending_approval",
        "gated",
        "shadow",
        "canary",
        "promoted",
        "rejected",
        "executed",
        "retired"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "change": {
      "type": "object",
      "required": [
        "skill",
        "reason",
        "decision",
        "production_change",
        "budget"
      ],
      "properties": {
        "schema_version": {
          "const": "skillcanary/change/v1"
        },
        "id": {
          "type": "string"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object"
        },
        "expected_transition": {
          "enum": [
            "FAIL->PASS",
            "COUNT->0"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 20
        },
        "decision": {
          "type": "string",
          "minLength": 20
        },
        "production_change": {
          "type": "boolean"
        },
        "prediction": {
          "type": "object"
        },
        "budget": {
          "type": "object",
          "required": [
            "repeat",
            "max_runs"
          ],
          "properties": {
            "repeat": {
              "type": "integer",
              "minimum": 3
            },
            "max_runs": {
              "type": "integer",
              "minimum": 3
            }
          }
        },
        "evidence": {
          "type": "object"
        },
        "provenance": {
          "type": "object"
        }
      }
    },
    "owner_scope": {
      "type": "string"
    },
    "owner_proposal": {
      "type": "object"
    },
    "owner_confirmation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "batch_id": {
          "type": "string"
        }
      }
    }
  }
}
