{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory scenario profile",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "required_capabilities",
    "primary_evaluators",
    "hard_gates",
    "evidence_contract",
    "routing_policy",
    "promotion_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "autoarmory/scenario-profile/v1"
    },
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1
    },
    "primary_evaluators": {
      "type": "array"
    },
    "trajectory_metrics": {
      "type": "array"
    },
    "hard_gates": {
      "type": "array",
      "minItems": 1
    },
    "evidence_contract": {
      "type": "array"
    },
    "routing_policy": {
      "type": "object"
    },
    "promotion_policy": {
      "type": "object"
    },
    "cost_policy": {
      "type": "object"
    },
    "human_review_policy": {
      "type": "object"
    }
  }
}
