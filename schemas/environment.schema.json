{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory environment fingerprint",
  "type": "object",
  "required": [
    "schema_version",
    "os",
    "node",
    "fingerprint",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": "selfforge/environment/v1"
    },
    "os": {
      "type": "string"
    },
    "release": {
      "type": "string"
    },
    "arch": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "npm": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "git_branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "package_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "package_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "fingerprint": {
      "type": "string"
    },
    "observed_at": {
      "type": "string"
    }
  }
}
