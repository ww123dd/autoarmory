{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutoArmory adapter descriptor",
  "type": "object",
  "required": [
    "id",
    "kind",
    "version",
    "input",
    "output",
    "permissions",
    "conformance"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "runner",
        "evaluator",
        "scanner",
        "mcp-gateway",
        "observability"
      ]
    },
    "version": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "output": {
      "type": "array",
      "minItems": 1
    },
    "permissions": {
      "type": "object"
    },
    "conformance": {
      "type": "object",
      "required": [
        "positive",
        "negative"
      ]
    },
    "budget": {
      "type": "object"
    }
  }
}
