{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelfForge decision record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "candidate_id",
    "action",
    "outcome",
    "reward"
  ],
  "properties": {
    "schema_version": {
      "const": "selfforge/decision/v1"
    },
    "id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "outcome": {
      "type": "object"
    },
    "reward": {
      "type": "number"
    },
    "verified": {
      "type": "boolean"
    },
    "recorded_at": {
      "type": "string"
    }
  }
}
